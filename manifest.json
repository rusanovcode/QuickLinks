{
  "manifest_version": 3,
  "name": "Quick Links Menu",
  "version": "2.0.0",
  "description": "Быстрые ссылки с коллекциями, поиском, резервным копированием и импортом/экспортом",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "tabs",
    "favicon"
  ],
  "action": {
    "default_title": "Quick Links Menu",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
