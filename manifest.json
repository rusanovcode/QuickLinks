{
  "manifest_version": 3,
  "name": "Quick Links Menu",
  "version": "1.0",
  "description": "Меню быстрого доступа с выбором иконок и отменой удаления",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}